{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "win-x64-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "architecture": { "value": "x64", "strategy": "external" },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "CMAKE_PREFIX_PATH": "$env{QT_ROOT}"
            },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
            "name": "win-x64-debug",
            "displayName": "Windows x64 Debug",
            "inherits": "win-x64-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "win-x64-release",
            "displayName": "Windows x64 Release",
            "inherits": "win-x64-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
        },
        {
            "name": "win-x64-ci",
            "displayName": "Windows x64 CI",
            "inherits": "win-x64-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "SKY_WARNINGS_AS_ERRORS": "ON" }
        }
    ],
    "buildPresets": [
        { "name": "win-x64-debug", "configurePreset": "win-x64-debug" },
        { "name": "win-x64-release", "configurePreset": "win-x64-release" },
        { "name": "win-x64-ci", "configurePreset": "win-x64-ci" }
    ],
    "testPresets": [
        {
            "name": "win-x64-debug",
            "configurePreset": "win-x64-debug",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "win-x64-ci",
            "configurePreset": "win-x64-ci",
            "output": { "outputOnFailure": true }
        }
    ]
}
