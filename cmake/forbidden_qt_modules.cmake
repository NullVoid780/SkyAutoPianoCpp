set(SKY_FORBIDDEN_QT_MODULES Qml Quick QuickControls2 QuickWidgets WebEngineCore WebEngineWidgets
    WebSockets Sql Multimedia)

function(sky_collect_targets dir out)
    get_property(targets DIRECTORY ${dir} PROPERTY BUILDSYSTEM_TARGETS)
    get_property(subdirs DIRECTORY ${dir} PROPERTY SUBDIRECTORIES)
    foreach(sub IN LISTS subdirs)
        sky_collect_targets(${sub} sub_targets)
        list(APPEND targets ${sub_targets})
    endforeach()
    set(${out} ${targets} PARENT_SCOPE)
endfunction()

function(sky_check_forbidden_qt_modules)
    sky_collect_targets(${CMAKE_SOURCE_DIR} targets)
    foreach(target IN LISTS targets)
        get_target_property(type ${target} TYPE)
        if(type STREQUAL "INTERFACE_LIBRARY")
            get_target_property(libs ${target} INTERFACE_LINK_LIBRARIES)
        else()
            get_target_property(libs ${target} LINK_LIBRARIES)
        endif()
        if(NOT libs)
            continue()
        endif()
        foreach(module IN LISTS SKY_FORBIDDEN_QT_MODULES)
            if("Qt6::${module}" IN_LIST libs OR "Qt::${module}" IN_LIST libs)
                message(FATAL_ERROR "Target '${target}' links the forbidden Qt module ${module}.")
            endif()
        endforeach()
    endforeach()
endfunction()
